# Development: HOST=127.0.0.1. Production: use a TLS reverse proxy.
HOST=127.0.0.1
PORT=3080
PUBLIC_BASE_URL=http://localhost:3080
SQLITE_PATH=./data/pokadrovo.sqlite
# Set a long random value in production; never commit the real one.
ANALYTICS_SECRET=CHANGE_ME_TO_RANDOM_32_BYTES
# JSON object e.g. {"subtitle_service":9900} (price in minor currency units)
SERVICES_JSON={}
# Optional email reset delivery
RESEND_API_KEY=
EMAIL_FROM=
# OAuth web app credentials and callbacks registered at Google/VK
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
